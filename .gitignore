# --- secrets -------------------------------------------------------------
# Local CA + server keys generated by `bridge.py --https`. Never commit:
# anyone holding ca.key can impersonate any site on phones that trust the CA.
.certs/

# --- environments and toolchains (re-created by the README setup steps) ----
.venv/
venv/
.toolchain/
__pycache__/
*.py[cod]

# --- build output (firmware/build.sh) --------------------------------------
firmware/xiao_test_tool/build/
*.elf
*.map

# --- run-time output: test reports, voice captures, logs, captures ----------
reports/
*.log
remote-log_*.txt
*.pcap
*.pcapng

# --- downloaded binaries and local backups ---------------------------------
# nrfutil: Nordic's CLI, downloaded (see README). bak/: dump of the board's
# original firmware (CURRENT.UF2) and old archives — keep them, just not in git.
/nrfutil
/bak/

# --- agent build briefs (kept locally, not published) ------------------------
/CLAUDE.md
/OPENCODE.md

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

